{
  "name": "agent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-to-agent ElevenLabs demo bridge (internal FDE tool).",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.elevenlabs.internal.agent-bridge",
    "productName": "Agent Bridge",
    "files": [
      "dist-electron/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "extraResources": [],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir"
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
