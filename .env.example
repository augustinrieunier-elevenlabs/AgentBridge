# Agent Bridge -- account configuration
#
# Copy this file to `.env` (never commit `.env`) and fill in one numbered
# block per ElevenLabs account/workspace you want to use as a Caller or
# Callee side. Leave API_KEY empty for an account that should only ever
# connect to PUBLIC agents (no key is sent at all in that case).
#
# Security notes (read before filling this in):
#  - Never put a customer's production API key here. Use your own internal
#    demo account, or ask the prospect for a public agent / sandbox account
#    (see spec-agent-bridge-demo.md section 12).
#  - `.env` stays on your machine. It is listed in .gitignore -- never
#    remove it from there, and never paste a real key into a commit, an
#    issue, a Slack message or this repo's history.
#  - This app never sends your key anywhere except https://api.elevenlabs.io
#    (and *.elevenlabs.io regional hosts, if you set BASE_URL below).

# ---- Account 1 -----------------------------------------------------------
ELEVENLABS_ACCOUNT_1_LABEL=Demo account A
ELEVENLABS_ACCOUNT_1_API_KEY=
# Optional: only set this if ElevenLabs gave your workspace a regional base
# URL (data residency). Leave empty to use https://api.elevenlabs.io.
ELEVENLABS_ACCOUNT_1_BASE_URL=

# ---- Account 2 -----------------------------------------------------------
ELEVENLABS_ACCOUNT_2_LABEL=Demo account B
ELEVENLABS_ACCOUNT_2_API_KEY=
ELEVENLABS_ACCOUNT_2_BASE_URL=

# Add more accounts by incrementing the number (ACCOUNT_3_*, ACCOUNT_4_*, ...).
